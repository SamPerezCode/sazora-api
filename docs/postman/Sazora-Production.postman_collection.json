    {
      "name": "02 - Recetas",
      "item": [
        {
          "name": "Crear receta como ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta exitosa\", () => {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "  pm.expect(pm.response.json().status).to.eql(\"success\");",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"recipeId\", json.data.recipe.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"PRUEBA-{{$timestamp}}\",\n  \"name\": \"Receta de prueba Postman\",\n  \"notes\": \"Creada durante la prueba integral\",\n  \"inputs\": [\n    {\n      \"inventoryItemId\": \"{{inputInventoryItemId}}\",\n      \"quantity\": \"1.000\",\n      \"notes\": null\n    }\n  ],\n  \"outputs\": [\n    {\n      \"inventoryItemId\": \"{{outputInventoryItemId}}\",\n      \"quantity\": \"1.000\",\n      \"costAllocationPercentage\": \"100.000000\",\n      \"notes\": null\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/production-recipes"
          }
        },
        {
          "name": "Consultar recetas como PRODUCTION",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta exitosa\", () => {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "  pm.expect(pm.response.json().status).to.eql(\"success\");",
                  "});"
