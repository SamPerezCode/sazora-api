            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipeId\": \"{{recipeId}}\",\n  \"locationId\": \"{{productionLocationId}}\",\n  \"batchQuantity\": \"1.000\",\n  \"plannedFor\": \"2026-12-01T15:00:00.000Z\",\n  \"notes\": \"Orden creada desde prueba Postman\"\n}",
