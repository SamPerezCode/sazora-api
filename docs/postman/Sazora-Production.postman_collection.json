                  "const order = pm.response.json().data.productionOrder;",
                  "pm.collectionVariables.set(\"productionOrderId\", order.id);",
                  "pm.collectionVariables.set(\"orderVersion\", String(order.version));",
                  "pm.expect(order.status).to.eql(\"DRAFT\");"
